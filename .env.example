PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-05-15
PUBLIC_SANITY_STUDIO_URL=http://localhost:5173/studio
SANITY_API_READ_TOKEN=

# Form + registration email (Resend). Without these, forms fail in production.
RESEND_API_KEY=
FORM_FROM_EMAIL="More Freedom Ahead <forms@your-verified-domain.com>"
# Fallback recipient if "Where form messages are sent" is empty in Site settings
CONTACT_TO_EMAIL=

# Stripe Checkout for paid event tickets
STRIPE_SECRET_KEY=
